msgid "You can edit the text. The changes are saved automatically."
msgstr ""
"Vous pouvez modifier le texte. Les modifications sont enregistrées "
"automatiquement."

msgid ""
"You can keep using Audiotext meanwhile. The result is saved in your "
"history and opens here when it's ready."
msgstr ""
"Vous pouvez continuer à utiliser Audiotext pendant ce temps. Le résultat "
"est enregistré dans votre historique et s’ouvre ici quand il est prêt."

msgid "You have the latest version."
msgstr "Vous avez la dernière version."

msgid "YouTube or a link to a file"
msgstr "YouTube ou lien vers un fichier"

msgid "YouTube video"
msgstr "Vidéo YouTube"

msgid "Your audio, video and saved files are not deleted."
msgstr "Vos fichiers audio, vidéo et enregistrés ne sont pas supprimés."

msgid "cancelled"
msgstr "annulé"

msgid "default"
msgstr "par défaut"

msgid "e.g. An interview about speech recognition"
msgstr "p. ex. Une interview sur la reconnaissance vocale"

msgid "e.g. Audiotext, WhisperX, Henestrosa"
msgstr "p. ex. Audiotext, WhisperX, Henestrosa"

msgid "or"
msgstr "ou"

msgid "xAI API key"
msgstr "Clé API xAI"

#, python-brace-format
msgid "{count} audio and video files (subfolders included)"
msgstr "{count} fichiers audio et vidéo (sous-dossiers inclus)"

#, python-brace-format
msgid "{count} done"
msgstr "{count} terminées"

#, python-brace-format
msgid "{count} failed"
msgstr "{count} échouées"

#, python-brace-format
msgid "{count} files"
msgstr "{count} fichiers"

#, python-brace-format
msgid "{count} transcriptions"
msgstr "{count} transcriptions"

