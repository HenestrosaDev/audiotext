msgstr "Bitmesi beklenen transkripsiyonlar: {count}."

msgid "Watch the folder"
msgstr "Klasörü izle"

msgid "Watched folder"
msgstr "İzlenen klasör"

msgid "Watching"
msgstr "İzleniyor"

