msgid "Waiting for the current transcription to finish."
msgstr "Čekání na dokončení aktuálního přepisu."

#, python-brace-format
msgid "Waiting for {count} transcription(s) to finish."
msgstr "Čekání na dokončení přepisů (počet: {count})."

msgid "Watch the folder"
msgstr "Sledovat složku"

msgid "Watched folder"
msgstr "Sledovaná složka"

msgid "Watching"
msgstr "Sledování"

msgid "Web subtitles (.vtt)"
msgstr "Webové titulky (.vtt)"

msgid "What do you want to transcribe?"
msgstr "Co chcete přepsat?"

msgid "What the audio is about, such as its topic or setting."
msgstr "O čem zvuk je, například jeho téma nebo prostředí."

#, python-brace-format
msgid ""
"Whisper can only translate into {english}. For other languages, it's "
"asked to write the transcription in {language} directly. It works well "
"for many languages, but check the result."
msgstr ""
"Whisper umí překládat pouze do jazyka: {english}. U ostatních jazyků je "
"požádán, aby přepis napsal přímo v jazyce: {language}. U mnoha jazyků to "
"funguje dobře, ale výsledek zkontrolujte."

msgid "Whisper transcribes and translates the audio in one step."
msgstr "Whisper přepíše a přeloží zvuk v jednom kroku."

msgid "WhisperX model ready."
msgstr "Model WhisperX je připraven."

msgid ""
"With timestamps, to play the transcription segment by segment and "
"generate subtitles."
msgstr ""
"S časovými značkami, aby bylo možné přepis přehrávat po segmentech a "
"generovat titulky."

msgid "Word document (.docx)"
msgstr "Dokument Word (.docx)"

msgid "Word-level timings"
msgstr "Časování slov"

#, python-brace-format
msgid "Write it directly in {language} (experimental)"
msgstr "Napsat přímo v jazyce: {language} (experimentální)"

msgid "You can edit the text. The changes are saved automatically."
msgstr "Text můžete upravit. Změny se ukládají automaticky."

msgid ""
"You can keep using Audiotext meanwhile. The result is saved in your "
"history and opens here when it's ready."
msgstr ""
"Mezitím můžete Audiotext dál používat. Výsledek se uloží do historie a "
"otevře se zde, až bude hotový."

msgid "You have the latest version."
msgstr "Máte nejnovější verzi."

msgid "YouTube or a link to a file"
msgstr "YouTube nebo odkaz na soubor"

msgid "YouTube video"
msgstr "Video z YouTube"

msgid "Your audio, video and saved files are not deleted."
msgstr "Vaše zvukové, video a uložené soubory se nesmažou."

msgid "cancelled"
msgstr "zrušeno"

msgid "default"
msgstr "výchozí"

msgid "e.g. An interview about speech recognition"
msgstr "např. Rozhovor o rozpoznávání řeči"

msgid "e.g. Audiotext, WhisperX, Henestrosa"
msgstr "např. Audiotext, WhisperX, Henestrosa"

msgid "float16 is faster on GPUs. int8 uses less memory."
msgstr "float16 je rychlejší na GPU. int8 využívá méně paměti."

msgid "or"
msgstr "nebo"

msgid "xAI API key"
msgstr "Klíč API xAI"

#, python-brace-format
msgid "{count} audio and video files (subfolders included)"
msgstr "Zvukové a video soubory: {count} (včetně podsložek)"

#, python-brace-format
msgid "{count} done"
msgstr "Hotovo: {count}"

#, python-brace-format
msgid "{count} failed"
msgstr "Selhalo: {count}"

#, python-brace-format
msgid "{count} files"
msgstr "Soubory: {count}"

#, python-brace-format
msgid "{count} transcriptions"
msgstr "Přepisy: {count}"

#, python-brace-format
msgid "{current} of {total}"
msgstr "{current} z {total}"

#, python-brace-format
msgid "{done}/{total} files"
msgstr "Soubory: {done}/{total}"

#, python-brace-format
msgid "{minutes} min {seconds} s"
msgstr "{minutes} min {seconds} s"

#, python-brace-format
msgid "{name}: {message}"
msgstr "{name}: {message}"

#, python-brace-format
msgid "{provider} is reading the transcription. It takes a moment."
msgstr "{provider} čte přepis. Chvíli to potrvá."

