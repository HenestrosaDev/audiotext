msgid "Translate with Whisper (recommended)"
msgstr "Перекладати за допомогою Whisper (рекомендовано)"

#: src/views/settings/cards/language_card.py:183
msgid ""
"The Google API can't translate. The transcription will be in the language"
" of the audio."
msgstr "Google API не вміє перекладати. Транскрипція буде мовою аудіо."

#: src/views/settings/cards/language_card.py:193
#, python-brace-format
msgid "Write it directly in {language} (experimental)"
msgstr "Писати одразу потрібною мовою ({language}, експериментально)"

#: src/views/settings/cards/language_card.py:211
msgid "Whisper transcribes and translates the audio in one step."
msgstr "Whisper транскрибує й перекладає аудіо за один крок."

#: src/views/settings/cards/language_card.py:215
#, python-brace-format
msgid ""
"Whisper can only translate into {english}. For other languages, it's "
"asked to write the transcription in {language} directly. It works well "
"for many languages, but check the result."
msgstr ""
"Whisper може перекладати лише цією мовою: {english}. Для інших мов його "
"просять одразу написати транскрипцію потрібною мовою ({language}). Для "
"багатьох мов це працює добре, але перевірте результат."

#: src/views/settings/cards/live_card.py:27
msgid "Live text"
msgstr "Живий текст"

#: src/views/settings/cards/live_card.py:30
