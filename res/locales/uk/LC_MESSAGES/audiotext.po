msgid "Format of the files."
msgstr "Формат файлів."

#: src/views/settings/cards/output_card.py:177
#, python-brace-format
msgid "The {model} model doesn't return timestamps, so it can't save subtitles."
msgstr "Модель {model} не повертає часові мітки, тому не може зберігати субтитри."

#: src/views/settings/cards/output_card.py:197
msgid "Choose where to save the transcriptions"
msgstr "Виберіть, куди зберігати транскрипції"

#: src/views/transcript/ask_panel.py:178 src/views/transcript/ask_panel.py:207
#: src/views/transcript/transcript_view.py:757
msgid "Ask"
msgstr "Запитати"

#: src/views/transcript/ask_panel.py:181
