msgstr "Модель для живого тексту"

#: src/views/settings/cards/live_card.py:62
#: src/views/settings/cards/options_card.py:120
#: src/views/settings/cards/options_card.py:149
msgid "Only available with WhisperX."
msgstr "Доступно лише з WhisperX."

#: src/views/settings/cards/live_card.py:65
msgid ""
"A fast model writes a draft while you speak. When you stop, the whole "
"recording is transcribed again with the model of the engine, which is "
"more accurate."
msgstr ""
"Швидка модель пише чернетку, поки ви говорите. Коли ви зупинитеся, увесь "
"запис транскрибується знову моделлю рушія, яка точніша."

#: src/views/settings/cards/live_card.py:70
msgid "The text is shown when you stop recording."
msgstr "Текст з'явиться, коли ви зупините запис."

#: src/views/settings/cards/options_card.py:38
msgid "Options"
msgstr "Параметри"

#: src/views/settings/cards/options_card.py:44
msgid "Word-level timings"
msgstr "Таймінг слів"

