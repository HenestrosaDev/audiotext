msgid ""
"Transcribes the audio and video files of the folder and its subfolders. "
"Files that already have a transcription are skipped unless you overwrite "
"them."
msgstr ""
"Транскрибує аудіо- та відеофайли папки та її підпапок. Файли, які вже "
"мають транскрипцію, пропускаються, якщо ви їх не перезаписуєте."

#: src/views/settings/cards/language_card.py:54
msgid "Language"
msgstr "Мова"

#: src/views/settings/cards/language_card.py:61
msgid "Language of the audio"
msgstr "Мова аудіо"

#: src/views/settings/cards/language_card.py:65
#: src/views/settings/cards/language_card.py:84
#: src/views/transcript/translation_panel.py:423
msgid "Search language…"
msgstr "Пошук мови…"

#: src/views/settings/cards/language_card.py:66
#: src/views/settings/cards/language_card.py:85
#: src/views/transcript/translation_panel.py:424
