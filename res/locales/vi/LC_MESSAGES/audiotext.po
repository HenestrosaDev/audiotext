msgid "Show the text while recording"
msgstr "Hiển thị văn bản khi ghi âm"

#: src/views/settings/cards/live_card.py:35
msgid "Live model"
msgstr "Mô hình trực tiếp"

#: src/views/settings/cards/live_card.py:62
#: src/views/settings/cards/options_card.py:120
#: src/views/settings/cards/options_card.py:149
msgid "Only available with WhisperX."
msgstr "Chỉ khả dụng với WhisperX."

#: src/views/settings/cards/live_card.py:65
msgid ""
"A fast model writes a draft while you speak. When you stop, the whole "
"recording is transcribed again with the model of the engine, which is "
"more accurate."
msgstr ""
"Một mô hình nhanh viết bản nháp trong khi bạn nói. Khi bạn dừng, toàn bộ "
"bản ghi được chép lời lại bằng mô hình của công cụ, chính xác hơn."

