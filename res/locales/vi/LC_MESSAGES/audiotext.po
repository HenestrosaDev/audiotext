msgid ""
"The Google API can't translate. The transcription will be in the language"
" of the audio."
msgstr "Google API không thể dịch. Bản chép lời sẽ ở ngôn ngữ của âm thanh."

#: src/views/settings/cards/language_card.py:193
#, python-brace-format
msgid "Write it directly in {language} (experimental)"
msgstr "Viết trực tiếp bằng {language} (thử nghiệm)"

#: src/views/settings/cards/language_card.py:211
msgid "Whisper transcribes and translates the audio in one step."
msgstr "Whisper chép lời và dịch âm thanh trong một bước."

#: src/views/settings/cards/language_card.py:215
#, python-brace-format
msgid ""
"Whisper can only translate into {english}. For other languages, it's "
"asked to write the transcription in {language} directly. It works well "
"for many languages, but check the result."
msgstr ""
"Whisper chỉ có thể dịch sang {english}. Với các ngôn ngữ khác, Whisper "
"được yêu cầu viết bản chép lời trực tiếp bằng {language}. Cách này hoạt "
"động tốt với nhiều ngôn ngữ, nhưng hãy kiểm tra kết quả."

#: src/views/settings/cards/live_card.py:27
msgid "Live text"
msgstr "Văn bản trực tiếp"

