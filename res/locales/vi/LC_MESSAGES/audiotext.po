#: src/views/settings/cards/context_card.py:115
#, python-brace-format
msgid "Not used by the {model} model."
msgstr "Không được mô hình {model} sử dụng."

#: src/views/settings/cards/engine_card.py:25
msgid "Identifies the speakers. With timestamps."
msgstr "Nhận diện người nói. Có dấu thời gian."

#: src/views/settings/cards/engine_card.py:28
msgid ""
"With timestamps, to play the transcription segment by segment and "
"generate subtitles."
msgstr "Có dấu thời gian, để phát bản chép lời theo từng đoạn và tạo phụ đề."

#: src/views/settings/cards/engine_card.py:32
msgid ""
"More accurate, but without timestamps: the transcription can't be played "
"segment by segment nor subtitled."
msgstr ""
"Chính xác hơn nhưng không có dấu thời gian: không thể phát bản chép lời "
"theo từng đoạn hay tạo phụ đề."

#: src/views/settings/cards/engine_card.py:50
msgid "Engine"
msgstr "Công cụ"

#: src/views/settings/cards/engine_card.py:54
msgid "Transcription method"
msgstr "Phương thức chép lời"

#: src/views/settings/cards/engine_card.py:114
msgid ""
"Only transcribes English, faster than the multilingual model of the same "
"size."
msgstr "Chỉ chép lời tiếng Anh, nhanh hơn mô hình đa ngôn ngữ cùng kích thước."

#: src/views/settings/cards/engine_card.py:118
msgid "Larger models are more accurate, but slower."
msgstr "Mô hình lớn hơn chính xác hơn nhưng chậm hơn."

#: src/views/settings/cards/engine_card.py:121
msgid "Runs on your computer. Free, private and unlimited."
msgstr "Chạy trên máy tính của bạn. Miễn phí, riêng tư và không giới hạn."

#: src/views/settings/cards/engine_card.py:131
msgid "Runs on the servers of OpenAI. Requires an API key."
msgstr "Chạy trên máy chủ của OpenAI. Cần khóa API."

#: src/views/settings/cards/engine_card.py:135
msgid ""
"Runs on the servers of Google. An API key is optional; without it, the "
"free tier is used."
msgstr ""
"Chạy trên máy chủ của Google. Khóa API là tùy chọn; nếu không có, gói "
"miễn phí sẽ được dùng."

#: src/views/settings/cards/engine_card.py:140
msgid "API key set"
msgstr "Đã đặt khóa API"

#: src/views/settings/cards/folder_card.py:22
msgid "Watch the folder"
msgstr "Theo dõi thư mục"

#: src/views/settings/cards/folder_card.py:34
msgid ""
"Keeps running and transcribes the files added to the folder, until you "
"stop it. The files it already contains are skipped."
msgstr ""
"Tiếp tục chạy và chép lời các tệp được thêm vào thư mục cho đến khi bạn "
"dừng. Các tệp đã có trong thư mục sẽ bị bỏ qua."

#: src/views/settings/cards/folder_card.py:39
msgid ""
"Transcribes the audio and video files of the folder and its subfolders. "
"Files that already have a transcription are skipped unless you overwrite "
"them."
msgstr ""
"Chép lời các tệp âm thanh và video trong thư mục và các thư mục con. Các "
"tệp đã có bản chép lời sẽ bị bỏ qua trừ khi bạn ghi đè."

