msgstr "Không tìm thấy ngôn ngữ."

#: src/views/settings/cards/language_card.py:71
msgid "Auto-detect"
msgstr "Tự động phát hiện"

#: src/views/settings/cards/language_card.py:80
msgid "Language of the transcription"
msgstr "Ngôn ngữ của bản chép lời"

#: src/views/settings/cards/language_card.py:90
msgid "Same as the audio"
msgstr "Giống âm thanh"

#: src/views/settings/cards/language_card.py:131
msgid "Translate with Whisper (recommended)"
msgstr "Dịch bằng Whisper (khuyên dùng)"

